# Copy to .env (never commit .env). docker_public helpers pass --env-file .env.
GEMINI_API_KEY=your-key-here
RJ_MODEL_ASSESSOR=gemma-4-31b-it
RJ_MODEL_PROPOSER=gemma-4-31b-it
RJ_MODEL_BASELINE=gemma-4-31b-it
RJ_MAX_CONCURRENCY=4
RJ_RPM=25
RJ_TPM=15000
RJ_TIME_BUDGET_S=3000
RJ_MAX_INDUCTION_CALLS=40
RJ_S_FRACTION=0.2
RJ_CHECKPOINT_EVERY=10
# Optional container paths (organizer defaults shown):
# RJ_INPUT_DIR=/input
# RJ_ARTIFACTS_DIR=/artifacts
# RJ_OUTPUT_DIR=/output
# Exact-request replay cache; mount this directory separately when using Docker.
# RJ_CACHE_DIR=/cache
# Development only: propagate exceptions instead of retaining degraded outputs.
# RJ_STRICT=1
# Offline only: use the deterministic fake LLM (not for reported model results).
# RJ_FAKE_LLM=1
